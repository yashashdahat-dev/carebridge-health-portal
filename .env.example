# =============================================================================
# CareBridge Clinical Portal — Environment Configuration Example
# File: .env.example
# Note: Copy to .env for local overrides. Never commit sensitive credentials.
# =============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development
RAW_PORT=5050

# Client Application URL (for CORS allowance)
CLIENT_URL=http://localhost:3000

# Relational Database Connection (PostgreSQL / MySQL)
DATABASE_URL=postgresql://carebridge_admin:secure_password@localhost:5432/carebridge_clinical?schema=public

# Document Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/carebridge_db

# Security & PHI Redaction
ENABLE_PHI_REDACTION=true
LOG_LEVEL=info

