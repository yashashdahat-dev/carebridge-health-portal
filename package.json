{
  "name": "carebridge-health-portal",
  "version": "1.0.0",
  "description": "Accessible Patient Triage & Multilingual Prescription Portal with ES6+ modules, structured clinical error handling, and accessible WCAG 2.1 AAA compliance.",
  "type": "module",
  "main": "js/main.js",
  "scripts": {
    "start": "vite",
    "serve": "vite",
    "dev": "vite",
    "dev:react": "vite",
    "server": "node server.js",
    "server:dev": "node --watch server.js",
    "server:raw": "node raw-server.js",
    "serve:legacy": "serve -l 3000 .",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --check js/errors.js && node --check js/clinical.js && node --check js/speech.js && node --check js/render.js && node --check js/main.js && node --test tests/*.test.js",
    "test:server": "node --test tests/server.test.js",
    "test:client": "node --test tests/error-handling.test.js",
    "audit": "npm audit"
  },
  "keywords": [
    "healthcare",
    "triage",
    "accessibility",
    "speech-synthesis",
    "multilingual",
    "vanilla-js",
    "wcag-aaa"
  ],
  "author": "CareBridge Clinical Development Team",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
